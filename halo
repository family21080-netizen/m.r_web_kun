
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080d18">
  <meta name="description" content="M.R Web Kun menyediakan jasa pembuatan website modern, responsif, dan terjangkau untuk bisnis dan personal.">
  <title>M.R Web Kun | Digital Website Studio</title>

  <style>
    :root {
      --bg: #080d18;
      --panel: #101a2b;
      --text: #f2f7ff;
      --muted: #9caec5;
      --cyan: #42e8ff;
      --blue: #5488ff;
      --line: rgba(120, 180, 255, .17);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 85px;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(1120px, 90%);
      margin: auto;
    }

    /* BACKGROUND ANIMATION */

    .background-glow {
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      overflow: hidden;
    }

    .orb {
      position: absolute;
      width: 350px;
      height: 350px;
      border-radius: 50%;
      filter: blur(100px);
      opacity: .15;
      animation: float 12s ease-in-out infinite alternate;
    }

    .orb.one {
      background: #087bff;
      top: 5%;
      left: -150px;
    }

    .orb.two {
      background: #00d9d0;
      top: 45%;
      right: -170px;
      animation-delay: -5s;
    }

    .orb.three {
      background: #6a39ff;
      bottom: -150px;
      left: 30%;
      animation-delay: -8s;
    }

    @keyframes float {
      from {
        transform: translate(0, 0) scale(1);
      }
      to {
        transform: translate(50px, 35px) scale(1.15);
      }
    }

    /* NAVIGATION */

    header {
      position: fixed;
      z-index: 100;
      top: 0;
      width: 100%;
      border-bottom: 1px solid transparent;
      background: rgba(8, 13, 24, .72);
      backdrop-filter: blur(16px);
      transition: .3s;
    }

    header.scrolled {
      border-bottom-color: var(--line);
      background: rgba(8, 13, 24, .94);
    }

    nav {
      height: 76px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 1.25rem;
      font-weight: 900;
      letter-spacing: -1px;
      white-space: nowrap;
    }

    .logo span {
      color: var(--cyan);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
      list-style: none;
    }

    .nav-links a {
      font-size: .9rem;
      color: var(--muted);
      transition: color .25s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--cyan);
    }

    .nav-cta {
      border: 1px solid rgba(66, 232, 255, .4);
      padding: 9px 16px;
      border-radius: 10px;
      color: var(--cyan);
      font-size: .85rem;
      transition: .3s;
    }

    .nav-cta:hover {
      background: var(--cyan);
      color: #07101a;
      box-shadow: 0 0 24px rgba(66, 232, 255, .2);
    }

    .menu-btn {
      display: none;
      border: 1px solid var(--line);
      background: var(--panel);
      color: white;
      padding: 7px 11px;
      border-radius: 8px;
      cursor: pointer;
    }

    /* HERO */

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 130px 0 80px;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      gap: 65px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 7px 13px;
      border: 1px solid var(--line);
      background: rgba(66, 232, 255, .05);
      border-radius: 50px;
      color: var(--cyan);
      font-size: .78rem;
      margin-bottom: 25px;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      background: #50ffac;
      border-radius: 50%;
      box-shadow: 0 0 12px #50ffac;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      50% { opacity: .4; }
    }

    .hero h1 {
      font-size: clamp(2.6rem, 5.4vw, 4.8rem);
      line-height: 1.08;
      letter-spacing: -3px;
      margin-bottom: 24px;
      animation: rise .9s both;
    }

    .gradient-text {
      background: linear-gradient(100deg, var(--cyan), #7d9cff 65%, #b8a2ff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-desc {
      max-width: 550px;
      color: var(--muted);
      font-size: 1.02rem;
      margin-bottom: 32px;
      animation: rise 1s .15s both;
    }

    .hero-actions {
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
      animation: rise 1s .3s both;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      padding: 13px 21px;
      border-radius: 11px;
      font-weight: 700;
      font-size: .9rem;
      transition: transform .3s, box-shadow .3s, background .3s;
      cursor: pointer;
    }

    .btn:hover {
      transform: translateY(-4px);
    }

    .btn-primary {
      color: #07101a;
      background: linear-gradient(110deg, var(--cyan), #7ca9ff);
      box-shadow: 0 8px 30px rgba(66, 232, 255, .13);
    }

    .btn-primary:hover {
      box-shadow: 0 10px 35px rgba(66, 232, 255, .3);
    }

    .btn-outline {
      border: 1px solid var(--line);
      background: rgba(255,255,255,.02);
      color: var(--text);
    }

    .btn-outline:hover {
      border-color: var(--cyan);
    }

    .hero-note {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      margin-top: 35px;
      color: var(--muted);
      font-size: .8rem;
    }

    .hero-note span::before {
      content: "✓";
      color: var(--cyan);
      margin-right: 7px;
    }

    @keyframes rise {
      from { opacity: 0; transform: translateY(25px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ANIMATED WEBSITE PREVIEW */

    .preview-wrap {
      position: relative;
      animation: rise 1s .2s both;
    }

    .preview-glow {
      position: absolute;
      inset: 10%;
      background: #1679ff;
      filter: blur(80px);
      opacity: .17;
    }

    .preview {
      position: relative;
      border: 1px solid rgba(125, 190, 255, .3);
      border-radius: 18px;
      background: rgba(13, 23, 40, .94);
      padding: 17px;
      box-shadow: 0 35px 90px rgba(0,0,0,.4);
      transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
      transition: transform .5s;
    }

    .preview:hover {
      transform: perspective(1000px) rotateY(0) rotateX(0) translateY(-5px);
    }

    .preview-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 15px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 18px;
    }

    .dots {
      display: flex;
      gap: 6px;
    }

    .dots i {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #43546e;
    }

    .dots i:first-child { background: #ff7070; }
    .dots i:nth-child(2) { background: #ffd166; }
    .dots i:nth-child(3) { background: #50dba0; }

    .preview-label {
      color: var(--muted);
      font-size: .7rem;
    }

    .preview-banner {
      min-height: 205px;
      border-radius: 12px;
      background:
        radial-gradient(ellipse at 80% 30%, rgba(66,232,255,.24), transparent 45%),
        linear-gradient(135deg, #142b4a, #10172a 70%);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    .preview-banner::after {
      content: "</>";
      position: absolute;
      right: 15px;
      bottom: -20px;
      color: rgba(66,232,255,.08);
      font-size: 8rem;
      font-weight: 900;
      animation: codeFloat 5s ease-in-out infinite alternate;
    }

    @keyframes codeFloat {
      to { transform: translateY(-12px) rotate(4deg); }
    }

    .preview-banner small {
      color: var(--cyan);
      margin-bottom: 8px;
    }

    .preview-banner strong {
      font-size: 1.8rem;
      line-height: 1.2;
      max-width: 240px;
    }

    .preview-banner p {
      color: var(--muted);
      font-size: .75rem;
      margin-top: 10px;
    }

    .preview-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 12px;
    }

    .mini-card {
      padding: 13px 10px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.025);
      border-radius: 10px;
      min-width: 0;
    }

    .mini-icon {
      color: var(--cyan);
      font-size: 1.25rem;
    }

    .mini-card strong {
      display: block;
      font-size: .75rem;
      margin-top: 5px;
    }

    .mini-card p {
      font-size: .64rem;
      color: var(--muted);
    }

    .floating-tag {
      position: absolute;
      right: -20px;
      top: 20%;
      padding: 12px 15px;
      background: #111d30;
      border: 1px solid rgba(66,232,255,.25);
      border-radius: 12px;
      font-size: .75rem;
      box-shadow: 0 12px 35px rgba(0,0,0,.25);
      animation: tagFloat 4s ease-in-out infinite;
    }

    .floating-tag b {
      color: var(--cyan);
      display: block;
    }

    @keyframes tagFloat {
      50% { transform: translateY(-12px); }
    }

    /* SECTION SHARED */

    section:not(.hero) {
      padding: 95px 0;
    }

    .section-head {
      text-align: center;
      max-width: 650px;
      margin: 0 auto 48px;
    }

    .section-label {
      color: var(--cyan);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: .75rem;
      font-weight: 700;
    }

    .section-head h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.2;
      margin: 12px 0 15px;
      letter-spacing: -1px;
    }

    .section-head p {
      color: var(--muted);
      font-size: .94rem;
    }

    /* SERVICES */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .service-card {
      padding: 28px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: linear-gradient(145deg, rgba(20,34,55,.72), rgba(12,20,34,.7));
      transition: transform .35s, border-color .35s, box-shadow .35s;
      position: relative;
      overflow: hidden;
    }

    .service-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--cyan), var(--blue));
      transition: width .4s;
    }

    .service-card:hover {
      transform: translateY(-8px);
      border-color: rgba(66,232,255,.45);
      box-shadow: 0 20px 50px rgba(0,0,0,.2);
    }

    .service-card:hover::before {
      width: 100%;
    }

    .service-icon {
      width: 53px;
      height: 53px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(66,232,255,.2);
      background: rgba(66,232,255,.07);
      border-radius: 14px;
      font-size: 1.5rem;
      margin-bottom: 22px;
      transition: transform .35s;
    }

    .service-card:hover .service-icon {
      transform: scale(1.1) rotate(-5deg);
    }

    .service-card h3 {
      font-size: 1.1rem;
      margin-bottom: 10px;
    }

    .service-card p {
      color: var(--muted);
      font-size: .87rem;
    }

    .service-link {
      display: inline-block;
      color: var(--cyan);
      font-size: .85rem;
      margin-top: 20px;
    }

    /* ABOUT */

    .about-grid {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 55px;
      align-items: center;
    }

    .about-visual {
      border: 1px solid var(--line);
      background:
        radial-gradient(circle at 50% 45%, rgba(66,232,255,.1), transparent 50%),
        var(--panel);
      border-radius: 20px;
      min-height: 340px;
      display: grid;
      place-items: center;
      overflow: hidden;
      position: relative;
    }

    .about-visual::before,
    .about-visual::after {
      content: "";
      position: absolute;
      width: 230px;
      height: 230px;
      border: 1px solid rgba(66,232,255,.15);
      border-radius: 50%;
      animation: orbit 15s linear infinite;
    }

    .about-visual::after {
      width: 170px;
      height: 170px;
      animation-direction: reverse;
    }

    @keyframes orbit {
      to { transform: rotate(360deg); }
    }

    .about-logo {
      font-size: 4rem;
      font-weight: 900;
      letter-spacing: -5px;
      z-index: 1;
      text-shadow: 0 0 35px rgba(66,232,255,.2);
    }

    .about-logo span { color: var(--cyan); }

    .about-content h2 {
      font-size: clamp(2rem, 4vw, 2.8rem);
      line-height: 1.2;
      margin: 12px 0 20px;
    }

    .about-content > p {
      color: var(--muted);
      font-size: .94rem;
      margin-bottom: 25px;
    }

    .feature-list {
      display: grid;
      gap: 15px;
    }

    .feature {
      display: flex;
      gap: 13px;
      align-items: flex-start;
    }

    .feature-check {
      color: var(--cyan);
      background: rgba(66,232,255,.09);
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 9px;
    }

    .feature strong { font-size: .93rem; }
    .feature p { color: var(--muted); font-size: .82rem; }

    /* PORTFOLIO */

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .project-card {
      border: 1px solid var(--line);
      border-radius: 15px;
      background: var(--panel);
      overflow: hidden;
      transition: transform .35s, border-color .35s;
    }

    .project-card:hover {
      transform: translateY(-7px);
      border-color: rgba(66,232,255,.4);
    }

    .project-art {
      min-height: 190px;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 25px;
      background: linear-gradient(145deg, #142d4b, #101729);
      overflow: hidden;
    }

    .project-art.purple {
      background: linear-gradient(145deg, #2b2052, #111729);
    }

    .project-art.green {
      background: linear-gradient(145deg, #123c3a, #101729);
    }

    .mock-window {
      width: 100%;
      max-width: 260px;
      padding: 12px;
      border: 1px solid rgba(255,255,255,.15);
      border-radius: 9px;
      background: rgba(8,13,24,.8);
      box-shadow: 0 15px 30px rgba(0,0,0,.25);
      transition: transform .4s;
    }

    .project-card:hover .mock-window {
      transform: scale(1.04) rotate(-1deg);
    }

    .mock-line {
      height: 6px;
      width: 70%;
      border-radius: 5px;
      background: rgba(66,232,255,.6);
      margin: 10px 0;
    }

    .mock-line.short { width: 40%; opacity: .5; }
    .mock-blocks { display: flex; gap: 7px; margin-top: 15px; }

    .mock-blocks i {
      display: block;
      height: 48px;
      flex: 1;
      border-radius: 5px;
      background: rgba(91,135,255,.2);
      border: 1px solid rgba(91,135,255,.2);
    }

    .project-info { padding: 20px; }
    .project-info h3 { font-size: 1rem; margin-bottom: 7px; }
    .project-info p { color: var(--muted); font-size: .83rem; }

    .project-tag {
      display: inline-block;
      margin-top: 14px;
      padding: 4px 9px;
      border-radius: 5px;
      background: rgba(66,232,255,.07);
      color: var(--cyan);
      font-size: .7rem;
    }

    /* PRICING */

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      align-items: stretch;
    }

    .price-card {
      padding: 29px;
      background: rgba(16,26,43,.8);
      border: 1px solid var(--line);
      border-radius: 17px;
      transition: transform .3s, border-color .3s;
    }

    .price-card:hover { transform: translateY(-5px); }

    .price-card.featured {
      border-color: rgba(66,232,255,.55);
      background: linear-gradient(155deg, rgba(26,53,76,.8), rgba(16,26,43,.9));
      box-shadow: 0 0 40px rgba(66,232,255,.06);
    }

    .price-badge {
      color: var(--cyan);
      font-size: .72rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
    }

    .price-card h3 { margin-top: 12px; font-size: 1.3rem; }

    .price {
      font-size: 2rem;
      font-weight: 800;
      margin: 17px 0 6px;
      letter-spacing: -1px;
    }

    .price small {
      font-size: .75rem;
      color: var(--muted);
      font-weight: 400;
      letter-spacing: 0;
    }

    .price-desc {
      font-size: .83rem;
      color: var(--muted);
      min-height: 48px;
    }

    .price-features {
      list-style: none;
      margin: 24px 0;
      display: grid;
      gap: 12px;
      font-size: .84rem;
      color: #c6d4e8;
    }

    .price-features li::before {
      content: "✓";
      color: var(--cyan);
      margin-right: 9px;
    }

    .price-card .btn { width: 100%; }

    /* CONTACT */

    .contact-panel {
      text-align: center;
      position: relative;
      overflow: hidden;
      padding: 60px 30px;
      border: 1px solid rgba(66,232,255,.25);
      border-radius: 22px;
      background:
        radial-gradient(ellipse at 50% 0%, rgba(66,232,255,.12), transparent 60%),
        rgba(16,26,43,.75);
    }

    .contact-panel h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.2;
      margin: 12px auto 18px;
      max-width: 650px;
    }

    .contact-panel p {
      color: var(--muted);
      max-width: 570px;
      margin: 0 auto 28px;
      font-size: .92rem;
    }

    .contact-panel .hero-actions { justify-content: center; }

    footer {
      border-top: 1px solid var(--line);
      padding: 27px 0;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .footer-content p {
      color: var(--muted);
      font-size: .8rem;
    }

    .footer-links {
      display: flex;
      gap: 18px;
      color: var(--muted);
      font-size: .8rem;
    }

    .footer-links a:hover { color: var(--cyan); }

    /* SCROLL REVEAL */

    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .75s ease, transform .75s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .delay-1 { transition-delay: .1s; }
    .delay-2 { transition-delay: .2s; }
    .delay-3 { transition-delay: .3s; }

    /* RESPONSIVE */

    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 55px;
      }

      .hero-copy { text-align: center; }
      .hero-desc { margin-left: auto; margin-right: auto; }
      .hero-actions, .hero-note { justify-content: center; }
      .preview-wrap { width: min(100%, 530px); margin: auto; }
      .services-grid, .portfolio-grid, .pricing-grid { grid-template-columns: repeat(2, 1fr); }
      .about-grid { grid-template-columns: 1fr; gap: 35px; }
      .about-visual { min-height: 270px; }
    }

    @media (max-width: 650px) {
      nav { height: 68px; }
      .menu-btn { display: block; }

      .nav-links {
        display: none;
        position: absolute;
        top: 68px;
        left: 5%;
        right: 5%;
        padding: 18px;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        border: 1px solid var(--line);
        border-radius: 13px;
        background: #0d1626;
        box-shadow: 0 20px 45px rgba(0,0,0,.35);
      }

      .nav-links.open { display: flex; }
      .nav-links a { display: block; padding: 12px; }
      .nav-cta { display: none; }

      .hero { min-height: auto; padding: 120px 0 70px; }
      .hero h1 { letter-spacing: -1.7px; }
      .hero-desc { font-size: .92rem; }
      .hero-note { gap: 10px 15px; }
      .floating-tag { right: -5px; }

      section:not(.hero) { padding: 70px 0; }
      .section-head { margin-bottom: 32px; }

      .services-grid, .portfolio-grid, .pricing-grid { grid-template-columns: 1fr; }
      .service-card { padding: 24px; }
      .price-card { padding: 25px; }

      .preview-banner { min-height: 180px; }
      .preview-banner strong { font-size: 1.5rem; }
      .preview-cards { gap: 7px; }
      .mini-card { padding: 10px 7px; }
      .mini-card strong { font-size: .67rem; }
      .mini-card p { font-size: .6rem; }

      .contact-panel { padding: 45px 20px; }
      .footer-content { justify-content: center; text-align: center; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
